# Runtime
SELF_BOT_ENV=development
LOG_LEVEL=INFO

# Storage
DATABASE_URL=sqlite:///./data/selfbot.db
DATABASE_ECHO=false

# Telegram credentials (configure only in the deployment environment)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Optional worker integration
PC_WORKER_ENABLED=false
PC_WORKER_URL=
PC_WORKER_TOKEN=
