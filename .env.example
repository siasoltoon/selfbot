# Runtime
SELF_BOT_ENV=development
LOG_LEVEL=INFO

# Storage
DATABASE_URL=sqlite:///./data/selfbot.db
DATABASE_ECHO=false

# Telegram credentials (configure only in the deployment environment)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Optional worker integration
PC_WORKER_ENABLED=false
PC_WORKER_URL=
PC_WORKER_TOKEN=

# Internal diamond economy (safe defaults; override only when intentionally rebalancing)
DIAMOND_MIN_TRANSFER=1
DIAMOND_MAX_TRANSFER=1000
DIAMOND_DAILY_TRANSFER_LIMIT=3000
DIAMOND_FEE_BPS=100
DIAMOND_MIN_FEE=1
DIAMOND_MAX_FEE=100
DIAMOND_MAX_ADMIN_ADJUSTMENT=100000

# Real Myoi bot username (Telegram)
MYOI_BOT_USERNAME=MeowieeeQBot
